# Copy to .env and fill in values. Identical file used by docker-compose.yml.

# --- MongoDB / Atlas ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true
# Single shared database. Staging consolidates BIAN banking records + this demo here.
DATABASE_NAME=leafy_bank_bian

# Optional: rename a physical collection at runtime with zero code edits
# (logical -> physical via COLL_<LOGICAL>; see db/collections_config.py).
# COLL_PAYMENTS=loanRepayments
# COLL_APPLICATIONS=loans
# COLL_DOCUMENTS=documents
# ... any collection from db/collections_config.py

# --- App ---
APP_NAME=agentic-lending

# --- AWS Bedrock ---
# Claude model / inference profile ARN
CHATCOMPLETIONS_MODEL_ID=
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=

# --- Voyage AI embeddings ---
VOYAGE_API_KEY=

# --- Atlas Vector Search index names ---
POLICIES_VECTOR_INDEX=policy_embed
DOCUMENTS_VECTOR_INDEX=document_embed

# --- CORS ---
ORIGINS=http://localhost:3000

# --- Demo business-rules (match frontend GDS_LIMIT/TDS_LIMIT) ---
CURRENT_5YR_FIXED_RATE=0.0489
DECLINE_RISK_SCORE=80
ESCALATE_PURCHASE_PRICE=500000
ESCALATE_GDS=0.36
ESCALATE_TDS=0.41

# --- Resilience ---
NODE_TIMEOUT_SECONDS=120
PIPELINE_TIMEOUT_SECONDS=600

# --- Optional: local PDF base dir override (defaults to repo docs/...) ---
# PDF_BASE_DIR=

# --- LangSmith observability (optional) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agentic-lending

# --- Runtime env tag ---
ENV=development
